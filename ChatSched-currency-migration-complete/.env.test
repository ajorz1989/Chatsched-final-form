# E2E Test Environment Variables
# Copy this to .env.test.local for local E2E testing
# These should be test/staging credentials, never production

# Supabase (test/staging project)
VITE_SUPABASE_URL=https://your-staging-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key

# Playwright configuration
PLAYWRIGHT_TEST_BASE_URL=http://localhost:5173

# Feature flags for testing
VITE_CHANNEL_SPORTS_ENABLED=false
VITE_CHANNEL_EVENTS_ENABLED=false
VITE_CHANNEL_COMMUNITY_ENABLED=false
VITE_CHANNEL_TRANSPORT_ENABLED=false
VITE_CHANNEL_INFORMAL_RETAIL_ENABLED=false
VITE_CHANNEL_ASSOCIATIONS_ENABLED=false
VITE_CHANNEL_RESTAURANTS_ENABLED=false

# Disable real integrations during testing
VITE_SENTRY_DSN=
VITE_PLAUSIBLE_DOMAIN=
