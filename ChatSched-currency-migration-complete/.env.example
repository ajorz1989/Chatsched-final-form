# Micro Billboards — environment variables
#
# This file was previously referenced by README.md's setup step 5 but
# didn't actually exist in the repo — copying it produced a "file not
# found." It's real now. Copy it:
#   cp .env.example .env
# then fill in real values. Without it, the app still runs in a degraded
# "not configured" mode (see src/lib/supabase.ts / SetupNotice.tsx) rather
# than crashing — but nothing that needs a backend will work.

# ── Frontend (Vite) ──────────────────────────────────────────────────────
# Exposed to the browser — anon key only, never the service role key.
# Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feature-flags one Channel Hub entry at a time (see src/lib/featureFlags.ts).
# social-media is always live and isn't a flag. The four below are launched
# and default to LIVE even left unset/blank — each is a kill switch, not an
# opt-in: set one to "false" to pull that channel back to "coming soon"
# without a code deploy. Leave unset (as below) to keep all four live.
VITE_CHANNEL_INFLUENCER_ENABLED=
VITE_CHANNEL_PODCAST_ENABLED=
VITE_CHANNEL_WEBSITE_ENABLED=
VITE_CHANNEL_RADIO_ENABLED=

# Phase 74-78 channels — also default to LIVE left unset/blank, same kill-
# switch model as the four above (see DEFAULT_ON in featureFlags.ts). Unlike
# the original four, these launched Phase 78 with zero real publishers or
# listings behind any of them — see CLAUDE_2.0.md items 3-7 and
# NEXT_STAGE_DEVELOPMENT_BRIEF.md before assuming "live" means "has supply."
VITE_CHANNEL_SPORTS_ENABLED=
VITE_CHANNEL_EVENTS_ENABLED=
VITE_CHANNEL_COMMUNITY_ENABLED=
VITE_CHANNEL_TRANSPORT_ENABLED=
VITE_CHANNEL_INFORMAL_RETAIL_ENABLED=
VITE_CHANNEL_ASSOCIATIONS_ENABLED=
VITE_CHANNEL_RESTAURANTS_ENABLED=

# Error tracking (Sentry) — see src/lib/errorTracking.ts. Without a DSN,
# errors still print to the console (so local dev needs nothing here);
# they just never leave the browser of whoever hit them. sentry.io →
# Settings → Projects → your project → Client Keys (DSN).
VITE_SENTRY_DSN=

# Optional — fraction (0 to 1) of page loads that report real-user
# performance data (Core Web Vitals: LCP, CLS, INP, TTFB) to Sentry,
# separate from error tracking, which always reports 100% of errors
# regardless of this value. Defaults to 0.1 (10%) if unset — deliberately
# not 1.0, to keep event volume proportional to actual need. Only takes
# effect when VITE_SENTRY_DSN is also set.
VITE_SENTRY_TRACES_SAMPLE_RATE=

# Analytics (Plausible) — see src/lib/analytics.ts. Cookieless, no consent
# banner needed. Without this set, no tracking script loads at all — not
# even to plausible.io. Set to the domain you registered in Plausible
# (usually just your site's domain, e.g. chatsched.com).
VITE_PLAUSIBLE_DOMAIN=

# ── Supabase Edge Functions ──────────────────────────────────────────────
# Set these as Edge Function secrets (`supabase secrets set ...`), not in
# this file — .env is for local frontend dev only and is never read by
# Deno. Listed here so there's one place that documents every secret the
# functions expect; see supabase/DEPLOY.md for the deploy sequence.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=
ADMIN_EMAIL=

# PayFast — used by payfast-checkout and payfast-notify (the live,
# tested-only-on-paper payment flow). PAYFAST_MODE=sandbox or live.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox

# Social account connect (social-oauth-start / social-oauth-callback) —
# OAUTH_STATE_SECRET is any long random string (e.g. `openssl rand -hex 32`),
# used to sign the OAuth `state` param so the callback can trust it wasn't
# tampered with. Both functions fail closed (a clear error, not an open
# door) if this is unset — but the connect flow simply won't work until it
# is. See supabase/functions/_shared/oauthState.ts.
OAUTH_STATE_SECRET=

# SOCIAL_TOKEN_ENCRYPTION_KEY — encrypts the actual YouTube/Facebook/
# Instagram/TikTok tokens social-oauth-callback stores in
# social_connections before they hit the database (AES-256-GCM; see
# supabase/functions/_shared/tokenCrypto.ts). Must be exactly 32 bytes,
# base64-encoded — generate with `openssl rand -base64 32`. Also fails
# closed if unset: social-oauth-callback refuses to store a token rather
# than falling back to plaintext. Keep this only as an Edge Function
# secret, same as every other value in this section — never commit a real
# one, and losing it means every already-connected social account needs
# to be reconnected (there's no way to decrypt without it, by design).
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Scheduled jobs (expire-channel-requests) — CRON_SECRET is any long random
# string, sent back as the `x-cron-secret` header by whatever scheduler
# calls this function (e.g. Supabase's own cron, or an external one).
# Fails closed if unset, same as OAUTH_STATE_SECRET above.
CRON_SECRET=

# Cloudflare Workers AI — used by publisher-authenticity-check only (the
# one AI feature deliberately kept off Anthropic; see that function's own
# header comment for why). Cloudflare dashboard → your account → Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Resend — used by the notify function. Until RESEND_FROM is a verified
# sending domain, mail sends from a shared sandbox address that won't
# reliably land in a stranger's inbox (see supabase/DEPLOY.md).
RESEND_API_KEY=
RESEND_FROM=

# Anthropic — used by audience-match (/match). Real Claude Haiku calls,
# gated behind login for cost control.
ANTHROPIC_API_KEY=

# SMS provider — used by send-otp for real phone verification. Provider-
# agnostic on purpose (Clickatell, BulkSMS, Twilio, etc. all work over a
# plain HTTP API) — fill in SMS_PROVIDER_API_URL to match whichever you
# pick, and update the fetch call in supabase/functions/send-otp/index.ts
# to match that provider's real request/response shape. Without a key set,
# OTP codes are still generated and stored correctly, just never sent —
# send-otp returns smsSent: false so the frontend can say so honestly.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_URL=

# ── workers/ (experimental payout pipeline — NOT the live payout system) ─
# See workers/README.md before using any of this. Not required for a
# normal deploy; the app's real payout mechanism ("mark payout sent" in
# Admin → Requests) needs none of these.
DATABASE_URL=
WORKER_POLL_INTERVAL_MS=60000
WORKER_MAX_RETRIES=3
PORT=3001
PAYFAST_API_BASE=
